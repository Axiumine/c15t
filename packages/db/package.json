{
  "name": "@consent/db",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsc -b tsconfig.json && node dist/migrate.js",
    "pull-c15t": "node scripts/pull-c15t.mjs"
  },
  "dependencies": {
    "@consent/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "better-auth": "1.7.14",
    "drizzle-kit": "0.31.11"
  }
}
