{
  "name": "c15t-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted cookie-consent platform: consent-api, dashboard-api, dashboard-web",
  "license": "AGPL-3.0-or-later",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -Api run dev",
    "build": "yarn workspaces foreach -Apt run build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:eslint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "spdx": "node scripts/add-spdx-headers.mjs",
    "spdx:check": "node scripts/add-spdx-headers.mjs --check",
    "semgrep": "bash scripts/semgrep.sh",
    "trivy": "bash scripts/trivy.sh",
    "db:migrate": "yarn workspace @consent/db run migrate",
    "db:pull-c15t": "yarn workspace @consent/db run pull-c15t",
    "c15t:plan": "c15t self-host migrate --config ./c15t-backend.config.ts --plan --no-telemetry",
    "c15t:migrate": "c15t self-host migrate --config ./c15t-backend.config.ts --apply --no-telemetry",
    "admin:create": "yarn workspace @consent/dashboard-api run admin:create",
    "knip": "knip",
    "type-coverage": "node scripts/type-coverage.mjs",
    "fta": "fta .",
    "code-caps": "node scripts/check-code-caps.ts",
    "test:scripts-coverage": "node --test --experimental-test-coverage --test-coverage-include=scripts/check-code-caps.ts '--test-coverage-include=scripts/code-caps/*.ts' --test-coverage-include=scripts/git-hooks.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 scripts/check-code-caps.test.mjs scripts/git-hooks.test.mjs",
    "postinstall": "node scripts/git-hooks.mjs install"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@c15t/backend": "3.1.0",
    "@c15t/cli": "3.1.0",
    "@effect/sql-pg": "4.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "effect": "4.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "fta-cli": "3.1.0",
    "globals": "17.13.0",
    "knip": "6.44.0",
    "lefthook": "2.2.2",
    "playwright-core": "1.64.1",
    "postgres": "3.4.9",
    "type-coverage": "2.31.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "typeCoverage": {
    "atLeast": 100,
    "strict": true,
    "ignoreFiles": [
      "**/dist/**",
      "**/*.generated.ts",
      "**/*.gen.ts"
    ]
  },
  "resolutions": {
    "@c15t/cli/postcss": "8.5.32",
    "@c15t/cli/zod": "4.6.7",
    "@ts-morph/common/minimatch": "11.0.1",
    "drizzle-kit/@esbuild-kit/esm-loader": "npm:tsx@4.23.15"
  }
}
