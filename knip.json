{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{mjs,ts}",
        "e2e/**/*.ts",
        "c15t-backend.config.ts",
        "playwright.config.ts",
        "vitest.mutation.config.ts"
      ],
      "project": ["scripts/**/*.{mjs,ts}", "e2e/**/*.ts", "*.ts"],
      "playwright": false
    },
    "apps/dashboard-api": {
      "entry": ["src/testing/tz-probe.ts"]
