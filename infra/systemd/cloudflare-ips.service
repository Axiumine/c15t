[Unit]
Description=Refresh Cloudflare IP ranges (nginx real_ip and firewall allowlist)
Documentation=file:///opt/c15t-platform/current/README.md
# After=nginx.service: the catch-up run after a boot (timer Persistent=true) should find nginx running.
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
# Optional settings, one KEY=VALUE per line: CF_NFT_APPLY=1 (load the nftables table after
# writing it), CF_UFW=1 (also write the ufw script), EXTRA_ALLOW=10.0.0.0/8, CF_FIREWALL_PORTS=80,443
EnvironmentFile=-/etc/c15t-platform/cloudflare-ips.env
ExecStart=/usr/bin/bash /opt/c15t-platform/current/infra/nginx/update-cloudflare-ips.sh
TimeoutStartSec=2min

# ---- Sandbox. This unit runs as root: it writes /etc/nginx/conf.d, tests and reloads nginx, and
# loads nftables (CAP_NET_ADMIN, AF_NETLINK). It needs no home directory, devices or kernel access.
# /etc/nftables.d may not exist yet (Debian and Ubuntu do not ship it). The "+" runs this one command
# outside the sandbox, before the read-only mounts that the main command gets.
ExecStartPre=+/usr/bin/install -d -m 0755 /etc/nftables.d
NoNewPrivileges=yes
ProtectSystem=strict
# Writable inside the read-only file system. A leading "-" ignores a path that does not exist.
#   /etc/nginx/conf.d, /etc/nftables.d, /etc/c15t-platform   the files this unit writes
#   /run              `nginx -t` opens its pid file (/run/nginx.pid) read-write even in test mode, and
#                     must be able to create it: the run after a boot happens before nginx has started.
#   /var/log/nginx, /var/lib/nginx, /var/cache/nginx   `nginx -t` opens every log file and creates the
#                     temp and cache directories. If a vhost logs or caches elsewhere, add those paths in a
#                     drop-in (systemctl edit cloudflare-ips.service: ReadWritePaths=/var/log/mysite).
ReadWritePaths=/etc/nginx/conf.d -/etc/nftables.d -/etc/c15t-platform /run -/var/log/nginx -/var/lib/nginx -/var/cache/nginx
# ...but not the parts of /run that control other services. `systemctl reload nginx` only connects to
# /run/systemd/private, and connecting to a socket works on a read-only mount.
ReadOnlyPaths=-/run/systemd -/run/dbus -/run/user -/run/udev
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
