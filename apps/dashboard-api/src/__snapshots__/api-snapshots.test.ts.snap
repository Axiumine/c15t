exports[`API response snapshots (pglite) > behavior > GET /api/sites and /api/sites/:siteKey: list item and detail with the setup text 1`] = `
{
  "detail": {
    "body": {
      "createdAt": "<timestamp>",
      "domains": [
        "<run>-snap.example.test",
      ],
      "key": "<run>-snap",
      "name": "Site <run>-snap",
      "policyPreset": "eu-opt-in",
      "setup": {
        "backendUrl": "/api/c15t",
        "nginx": "set $c15t_site <run>-snap;
include snippets/c15t.conf;",
        "scriptTag": "<script src="/api/c15t/c15t.js" data-cfasync="false" data-categories="measurement,marketing"></script>",
        "serverClient": "import { createC15tClient } from '@c15t/node-sdk';

const c15t = createC15tClient({
  baseUrl: \`\${process.env.CONSENT_API_URL}/s/<run>-snap\`,
  apiKey: process.env.C15T_ADMIN_API_KEY,
});",
      },
      "status": "active",
      "updatedAt": "<timestamp>",
    },
    "status": 200,
  },
  "list": {
    "body": {
      "items": [
        {
          "createdAt": "<timestamp>",
          "domains": [
            "<run>-snap.example.test",
          ],
          "key": "<run>-snap",
          "name": "Site <run>-snap",
          "policyPreset": "eu-opt-in",
          "status": "active",
          "updatedAt": "<timestamp>",
        },
      ],
    },
    "status": 200,
  },
}
`;

