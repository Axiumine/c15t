exports[`API response snapshots (pglite) > behavior > the error envelope: unauthenticated, forbidden, unknown site, invalid query 1`] = `
{
  "foreignSite": {
    "body": {
      "error": {
        "code": "NOT_FOUND",
        "message": "Site not found",
      },
    },
    "status": 404,
  },
  "invalidLimit": {
    "body": {
      "error": {
        "code": "VALIDATION_ERROR",
        "issues": [
          {
            "message": "Too small: expected number to be >=1",
            "path": "limit",
          },
        ],
        "message": "The request is invalid",
      },
    },
    "status": 400,
  },
  "invalidRange": {
    "body": {
      "error": {
        "code": "VALIDATION_ERROR",
        "issues": [
          {
            "message": "\`from\` must not be after \`to\`",
            "path": "from",
          },
        ],
        "message": "The request is invalid",
      },
    },
    "status": 400,
  },
  "noSession": {
    "body": {
      "error": {
        "code": "UNAUTHORIZED",
        "message": "Authentication is required",
      },
    },
    "status": 401,
  },
  "userOnAdminRoute": {
    "body": {
      "error": {
        "code": "FORBIDDEN",
        "message": "Administrator access is required",
      },
    },
    "status": 403,
  },
}
`;
