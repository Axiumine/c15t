# Copy to the dev env file (cp env.example <dotfile>); Yarn injects it into every `yarn <script>`.
# Production uses /etc/c15t-platform/{consent-api,dashboard-api}.env (owner c15t, mode 0600) and no dotfiles.
# Each app validates its own variables with zod in src/env.ts; the defaults below live there too.

# ---- Network (docs/configuration.md, "Network") ----
# Bind addresses must be loopback or private LAN: 127.0.0.0/8, ::1, 10/8, 172.16/12, 192.168/16,
# 100.64.0.0/10, fc00::/7. 0.0.0.0, :: and public addresses are rejected. Ports: 1024-65535.
# CONSENT_API_HOST=            # default 127.0.0.1
# CONSENT_API_PORT=            # default 4100
# CIDRs allowed to send X-Forwarded-* / CF-* headers; stripped from every other peer.
# CONSENT_API_TRUSTED_PROXIES= # default 127.0.0.1/32,::1/128
# CONSENT_API_INSTANCE_POOL_MAX= # default 2 (1-3), connections per site instance
# CONSENT_API_REGISTRY_POOL_MAX= # default 2 (1-3)
# CONSENT_API_DB_PREPARE=      # default true; false only behind PgBouncer transaction mode
# How website servers reach consent-api. dashboard-api accepts it too, but does not use it yet
# (reserved for future @c15t/node-sdk calls), so it is optional there.
# CONSENT_API_URL=             # default http://127.0.0.1:4100
# DASHBOARD_API_HOST=          # default 127.0.0.1
# DASHBOARD_API_PORT=          # default 4200
# Vite dev server port; it binds 127.0.0.1 and proxies /api to dashboard-api.
# DASHBOARD_WEB_DEV_PORT=      # default 5173

# ---- Database (Patroni: use the internal DNS name of the primary, never a node name or IP) ----
# Role c15t_api (owns schema c15t): consent-api and the c15t CLI.
DATABASE_URL_C15T=
# Role dashboard (owns schema app, SELECT on c15t.*): dashboard-api and `yarn db:migrate`.
DATABASE_URL_DASHBOARD=
# Optional: same role on the replica endpoint, used only for c15t stats, search and export.
# DATABASE_URL_DASHBOARD_REPLICA=   (leave unset locally)
# TLS: never put sslrootcert=<file> in a URL (postgres.js would send it to Postgres, which rejects it).
# For a private CA, set the Node variable below in the service env file instead; it covers both drivers.
# NODE_EXTRA_CA_CERTS=/etc/ssl/c15t/ca.pem

# ---- Secrets (server-side only, never sent to a browser) ----
# Bearer key for the c15t admin endpoints. Required by consent-api, at least 16 characters, e.g.
# openssl rand -hex 32. Also used by website servers. Optional in dashboard-api (reserved, unused today: leave it out of dashboard-api.env).
C15T_ADMIN_API_KEY=
# At least 32 characters, e.g. openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public dashboard origin, e.g. https://dashboard.example.com (dev: the Vite origin). It must equal the
# exact origin the browser uses (scheme, host and port), or every sign-in is rejected with a 403.
BETTER_AUTH_URL=

# ---- Development tooling (never read by the apps) ----
# Qodana Cloud project token for `yarn qodana` (copy it from the project in Qodana Cloud); leave it empty to skip Qodana.
# QODANA_TOKEN=
